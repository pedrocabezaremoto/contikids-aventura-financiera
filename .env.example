# Copiar a .env (en la raíz del repo) y cambiar los valores. El .env real NUNCA se sube.

# --- Postgres de Contikids (docker-compose) ---
POSTGRES_USER=contikids
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=contikids
# Desarrollo: se publica solo en 127.0.0.1:5433 (el 5432 es del Postgres del host).
POSTGRES_PORT=5433

# --- API (NestJS + Prisma) ---
DATABASE_URL=postgresql://contikids:cambia-esta-clave@127.0.0.1:5433/contikids?schema=public
API_HOST=127.0.0.1
API_PORT=4410
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://127.0.0.1:5173
# Para la Fase 1 (auth). Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Seed de demo (datos ficticios) ---
SEED_TEACHER_EMAIL=docente@contikids.test
SEED_TEACHER_PASSWORD=cambia-esta-clave
# 1 = regenerar e imprimir de nuevo los PIN de los alumnos demo
SEED_RESET_DEMO_PINS=0
