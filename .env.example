# Copiar a .env (en la raíz del repo) y cambiar los valores. El .env real NUNCA se sube.

# --- Postgres de Contikids (docker-compose) ---
POSTGRES_USER=contikids
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=contikids
# Se publica solo en 127.0.0.1:5433 (el 5432 es del Postgres del host). Lo usa `pnpm dev`.
POSTGRES_PORT=5433

# --- API en desarrollo (pnpm dev:api, corre en el host) ---
DATABASE_URL=postgresql://contikids:cambia-esta-clave@127.0.0.1:5433/contikids?schema=public
API_HOST=127.0.0.1
API_PORT=4410
# Orígenes permitidos por CORS en desarrollo (separados por coma)
CORS_ORIGIN=http://127.0.0.1:5173
# Para la Fase 1 (auth). Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Producción (docker compose up -d) ---
# URL pública: la usan el CORS de la api en producción y el health check de deploy.sh.
#   VPS:    https://contikids.pedroservicios.xyz
#   Laptop: http://localhost
PUBLIC_URL=https://contikids.pedroservicios.xyz
# Dónde se publica el contenedor web (Nginx). Nunca 0.0.0.0.
#   VPS:    WEB_BIND=172.18.0.1  WEB_PORT=4400   (solo lo alcanza Traefik)
#   Laptop: WEB_BIND=127.0.0.1   WEB_PORT=80
WEB_BIND=172.18.0.1
WEB_PORT=4400

# --- Webhook de auto-deploy (solo VPS) ---
# Secreto compartido con GitHub. Generar con: openssl rand -hex 32
WEBHOOK_SECRET=
WEBHOOK_HOST=172.18.0.1
WEBHOOK_PORT=4420

# --- Seed de demo (datos ficticios) ---
SEED_TEACHER_EMAIL=docente@contikids.test
SEED_TEACHER_PASSWORD=cambia-esta-clave
# 1 = regenerar e imprimir de nuevo los PIN de los alumnos demo
SEED_RESET_DEMO_PINS=0
